{
  "name": "plumber-growth-website-template",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Next.js plumbing website template for the Plumber Growth System. Static export to Cloudflare Pages; native forms processed by Cloudflare Pages Functions and delivered to GoHighLevel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
