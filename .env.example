# =============================================================================
# Plumber Growth System — environment variables (see docs/11 §25, docs/05 §21)
#
# Copy to `.env.local` for local dev and set the real values in the Cloudflare
# Pages project for preview/production. NEVER commit real secrets (docs/05 SEC-006).
# Only NEXT_PUBLIC_* values are exposed to the browser bundle.
# =============================================================================

# --- Public (browser-exposed) ------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=""

# --- Client GHL integration (server-only, Cloudflare Functions) --------------
GHL_LOCATION_ID=""
GHL_PRIVATE_INTEGRATION_TOKEN=""
GHL_PIPELINE_ID=""
GHL_STAGE_NEW_LEAD_ID=""
GHL_STAGE_CONTACT_ATTEMPTED_ID=""
GHL_STAGE_CONNECTED_ID=""
GHL_STAGE_ESTIMATE_REQUESTED_ID=""
GHL_STAGE_ESTIMATE_SCHEDULED_ID=""
GHL_STAGE_ESTIMATE_SENT_ID=""
GHL_STAGE_JOB_WON_ID=""
GHL_STAGE_JOB_LOST_ID=""
GHL_STAGE_FOLLOW_UP_NEEDED_ID=""
# JSON string mapping canonical app field keys -> GHL custom field IDs
GHL_CUSTOM_FIELD_MAP="{}"
# JSON string mapping canonical tag keys -> GHL tag strings
GHL_TAG_MAP="{}"
GHL_CALENDAR_ID=""

# --- Form security (server-only) ---------------------------------------------
TURNSTILE_SECRET_KEY=""
FORM_SIGNING_SECRET=""
IDEMPOTENCY_NAMESPACE="pgs-idempotency"
RATE_LIMIT_NAMESPACE="pgs-rate-limit"

# --- Agency onboarding (server-only, isolated from client creds) -------------
AGENCY_GHL_LOCATION_ID=""
AGENCY_GHL_PRIVATE_INTEGRATION_TOKEN=""
AGENCY_ONBOARDING_FIELD_MAP="{}"
AGENCY_FULFILLMENT_PIPELINE_ID=""
AGENCY_STAGE_ASSETS_RECEIVED_ID=""
